# ============================================================
# Nokia Bell XG-040G-MD (Airoha AN7581DT) — Lean lede 编译配置
# 基于 coolsnowwolf/lede master（内核 6.18 / luci openwrt-25.12）
# 用法：cp configs/xg040g-md.config lede/.config && make defconfig
# 改插件：直接增删下面的 CONFIG_PACKAGE_xxx=y 行即可
# ============================================================

# ---------- 目标平台与机型（不要改） ----------
CONFIG_TARGET_airoha=y
CONFIG_TARGET_airoha_an7581=y
CONFIG_TARGET_airoha_an7581_DEVICE_nokia_xg-040g-md-ubi=y

# ---------- 中文界面 ----------
CONFIG_PACKAGE_luci-i18n-base-zh-cn=y
CONFIG_PACKAGE_luci-i18n-firewall-zh-cn=y

# ---------- 主题 ----------
CONFIG_PACKAGE_luci-theme-argon=y
CONFIG_PACKAGE_luci-app-argon-config=y

# ---------- 系统工具 ----------
CONFIG_PACKAGE_luci-app-ttyd=y
CONFIG_PACKAGE_luci-app-filetransfer=y
CONFIG_PACKAGE_luci-app-airoha-npu=y

# ---------- 网络功能 ----------
CONFIG_PACKAGE_luci-app-upnp=y
CONFIG_PACKAGE_luci-app-ddns=y
CONFIG_PACKAGE_luci-app-wol=y
CONFIG_PACKAGE_luci-app-sqm=y
CONFIG_PACKAGE_luci-app-nlbwmon=y
CONFIG_PACKAGE_luci-app-zerotier=y

# ---------- 文件共享 (SMB) ----------
CONFIG_PACKAGE_luci-app-samba4=y
CONFIG_PACKAGE_ksmbd-tools=y

# ============================================================
# 代理插件
# ============================================================
# 1) OpenClash —— 来自 luci feed（openwrt-25.12），mihomo 内核首次运行时在线下载
CONFIG_PACKAGE_luci-app-openclash=y

# 2) SSR+ (ssr-plus) —— 来自 helloworld feed，自带 Xray / V2Ray / SS 系列核心
CONFIG_PACKAGE_luci-app-ssr-plus=y

# 3) 加速：不装 TurboACC（lede 25.12 分支已移除该插件，且本内核缺 fast-classifier 补丁）
#    改为内核原生方案：BBR 拥塞控制 + 防火墙 flow offloading
#    files/etc/uci-defaults/99-turbo-offload 会在首次启动时自动开启两者
CONFIG_PACKAGE_kmod-tcp-bbr=y
CONFIG_PACKAGE_kmod-nft-offload=y

# ============================================================
# USB 移动网络模块（4G/5G 上网卡、M.2/USB 模组）
# ============================================================
# --- QModem 主程序与 LuCI 界面（feed: https://github.com/FUjr/QModem） ---
CONFIG_PACKAGE_qmodem=y
CONFIG_PACKAGE_luci-app-qmodem=y
CONFIG_PACKAGE_luci-app-qmodem-hc=y
CONFIG_PACKAGE_luci-app-qmodem-sms=y
CONFIG_PACKAGE_luci-app-qmodem-monitor=y
CONFIG_PACKAGE_sms-tool-js=y

# --- 拨号协议与工具 ---
CONFIG_PACKAGE_wwan=y
CONFIG_PACKAGE_uqmi=y
CONFIG_PACKAGE_umbim=y
CONFIG_PACKAGE_comgt=y
CONFIG_PACKAGE_usb-modeswitch=y

# --- USB 串口驱动（AT 口 / 拨号口） ---
CONFIG_PACKAGE_kmod-usb-serial=y
CONFIG_PACKAGE_kmod-usb-serial-option=y
CONFIG_PACKAGE_kmod-usb-serial-wwan=y
CONFIG_PACKAGE_kmod-usb-serial-sierrawireless=y
CONFIG_PACKAGE_kmod-usb-acm=y
CONFIG_PACKAGE_kmod-usb-wdm=y

# --- USB 网卡驱动（QMI / MBIM / NCM / RNDIS / ECM 模组） ---
CONFIG_PACKAGE_kmod-usb-net=y
CONFIG_PACKAGE_kmod-usb-net-qmi-wwan=y
CONFIG_PACKAGE_kmod-usb-net-cdc-mbim=y
CONFIG_PACKAGE_kmod-usb-net-cdc-ncm=y
CONFIG_PACKAGE_kmod-usb-net-huawei-cdc-ncm=y
CONFIG_PACKAGE_kmod-usb-net-rndis=y
CONFIG_PACKAGE_kmod-usb-net-cdc-ether=y

# ---------- USB 存储支持（挂 U 盘 / 日志 / Docker 必需） ----------
CONFIG_PACKAGE_kmod-usb-storage=y
CONFIG_PACKAGE_kmod-usb-storage-uas=y
CONFIG_PACKAGE_kmod-usb-storage-extras=y
CONFIG_PACKAGE_kmod-fs-ext4=y
CONFIG_PACKAGE_kmod-fs-vfat=y
CONFIG_PACKAGE_kmod-fs-exfat=y
CONFIG_PACKAGE_kmod-fs-ntfs3=y
CONFIG_PACKAGE_block-mount=y
CONFIG_PACKAGE_automount=y
CONFIG_PACKAGE_e2fsprogs=y

# ---------- Docker（默认关闭：256MB NAND 装不下，且必须外挂 U 盘/移动硬盘） ----------
# 需要在设备上跑容器时，把下面 4 行取消注释，并务必挂好 USB 存储
# CONFIG_PACKAGE_docker=y
# CONFIG_PACKAGE_dockerd=y
# CONFIG_PACKAGE_containerd=y
# CONFIG_PACKAGE_luci-app-dockerman=y
